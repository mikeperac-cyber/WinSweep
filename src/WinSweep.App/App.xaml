<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinSweep.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinSweep.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-owned brushes, so the layout never depends on built-in theme keys. -->
            <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="PositiveBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#66000000" />

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
            <converters:PositiveIntToBooleanConverter x:Key="PositiveIntToBooleanConverter" />

            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#D9D9D5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="UtilityButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="Foreground" Value="#E8E6E1" />
                <Setter Property="BorderBrush" Value="#25FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F1EFE9" />
                <Setter Property="Foreground" Value="#202428" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="24,11" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
