<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,26,36,24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Apps" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.66" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Check for updates" Click="CheckUpdates_Click" />
                <Button Content="Open Store updates" Click="StoreUpdates_Click" ToolTipService.ToolTip="Microsoft Store apps are updated by the Store itself." />
                <Button Content="Refresh list" Click="Reload_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="Search installed apps" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="Select an app to review its uninstaller and leftover data." Opacity="0.55" VerticalAlignment="Center" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,12"
            Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="Updates available" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Update all" Click="UpdateAll_Click" HorizontalAlignment="Right" />
                </Grid>
                <ListView ItemsSource="{Binding Updates}" SelectionMode="None" MaxHeight="180">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="2,4" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" Opacity="0.7" />
                                    <TextBlock Text="&#x2192;" Opacity="0.5" />
                                    <TextBlock Text="{Binding Available}" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Update" Tag="{Binding Id}" Click="Update_Click" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <ListView
            Grid.Row="3"
            ItemsSource="{Binding Apps}"
            SelectionMode="Single"
            SelectionChanged="Apps_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,9" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1CFFFFFF" VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE71D;"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.82" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Publisher}" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Version}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SourceDisplay}" Opacity="0.5" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.85" TextAlignment="Right" />
                        <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Opacity="0.55" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="4"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding SelectedAppName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UninstallCommandText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxLines="3" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3" MaxHeight="120">
                    <TextBlock Text="Related data" FontWeight="SemiBold" FontSize="12" Opacity="0.65" />
                    <ListView ItemsSource="{Binding Leftovers}" SelectionMode="None" MaxHeight="90">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="34" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Reason}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Review leftovers" Click="Review_Click" />
                    <Button Content="Uninstall" Click="Uninstall_Click" />
                    <Button Content="Remove selected data" Click="RemoveLeftovers_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
