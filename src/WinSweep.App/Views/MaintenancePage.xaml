<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,28,36,26">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="560"
            Spacing="18"
            Visibility="{Binding LandingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="124" Height="124" CornerRadius="62" Background="#272C2B" HorizontalAlignment="Center">
                <Grid>
                    <Ellipse Width="82" Height="82" Fill="#383B39" Stroke="#B7C2BB" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE90F;" FontSize="37" Foreground="#E4E8E3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="Small fixes. No magic." FontSize="29" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock
                Text="Review specific Windows maintenance tasks. Each one explains what it changes; nothing runs in the background."
                FontSize="15"
                Opacity="0.72"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center" />
            <Button Content="Review maintenance" Click="ReviewTasks_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{Binding IsBusy}" Width="42" Height="42" HorizontalAlignment="Center" />
            <TextBlock Text="Working on one task" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
        </StackPanel>

        <Grid Visibility="{Binding TasksVisible, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Maintenance" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding Tasks}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,14" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                    <Border Background="#18FFFFFF" CornerRadius="5" Padding="7,2" Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Administrator" FontSize="11" Opacity="0.75" />
                                    </Border>
                                    <Border Background="#18FFFFFF" CornerRadius="5" Padding="7,2" Visibility="{Binding IsCheck, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Read only" FontSize="11" Opacity="0.75" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Opacity="0.8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Impact}" Opacity="0.58" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding StatusText}" Opacity="0.82" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <Button Content="Run" Tag="{Binding Id}" Click="Run_Click" HorizontalAlignment="Right" />
                                <Button Content="Run as administrator" Tag="{Binding Id}" Click="RunElevated_Click" HorizontalAlignment="Right" Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
