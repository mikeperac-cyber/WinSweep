<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,26,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="142" />
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Machine status" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HostText}" Opacity="0.68" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="76" Height="76" CornerRadius="38" Background="#2083B9A0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HealthScoreText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Health" FontSize="13" Opacity="0.62" />
                        <TextBlock Text="{Binding HealthSummary}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UptimeText}" FontSize="12" Opacity="0.62" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="CPU" FontSize="13" Opacity="0.62" />
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CpuValueText}" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="%" FontSize="16" Opacity="0.65" Margin="0,0,0,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding CpuDetailText}" FontSize="12" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Memory" FontSize="13" Opacity="0.62" />
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding MemoryValueText}" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="%" FontSize="16" Opacity="0.65" Margin="0,0,0,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding MemoryDetailText}" FontSize="12" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Free space" FontSize="13" Opacity="0.62" />
                    <TextBlock Text="{Binding SystemDriveText}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SystemDriveFreeText}" FontSize="12" Opacity="0.62" />
                    <ProgressBar Value="{Binding SystemDriveUsedPercent}" Maximum="100" Height="4" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Battery" FontSize="13" Opacity="0.62" />
                    <TextBlock Text="{Binding BatteryValueText}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BatteryDetailText}" FontSize="12" Opacity="0.62" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Network" FontSize="13" Opacity="0.62" />
                    <TextBlock Text="{Binding NetworkSummary}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NetworkDetails}" FontSize="12" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="19" VerticalAlignment="Center" Opacity="0.72" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Drives}" MaxHeight="84">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="9" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding UsedPercent}" Maximum="100" Height="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FreeDisplay}" FontSize="11" Opacity="0.68" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Processes" FontSize="17" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Padding="4,3" Opacity="0.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="CPU" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="Memory" FontSize="11" />
                </Grid>
                <ListView Grid.Row="2" ItemsSource="{Binding TopProcesses}" SelectionMode="None" MaxHeight="290">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent}" Opacity="0.7" />
                                <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
