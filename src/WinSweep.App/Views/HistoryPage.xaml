<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="History" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Everything the app changed, newest first." Opacity="0.7" />
            </StackPanel>

            <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource CardBrush}"
            CornerRadius="12"
            Padding="18"
            BorderBrush="{StaticResource CardStrokeBrush}"
            BorderThickness="1">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Sweeps you can undo" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Swept files are kept in the quarantine vault until they expire. Restoring never overwrites a file that exists." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="Undo last sweep"
                        VerticalAlignment="Center"
                        Click="UndoLast_Click"
                        IsEnabled="{Binding HasUndoableSweep}" />
                </Grid>

                <TextBlock
                    Text="No sweeps are in quarantine."
                    Opacity="0.6"
                    Visibility="{Binding HasSweeps, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />

                <ListView
                    ItemsSource="{Binding Sweeps}"
                    SelectionMode="None"
                    MaxHeight="260"
                    Visibility="{Binding HasSweeps, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="2,6" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceText}" Opacity="0.7" />
                                        <TextBlock Text="{Binding SizeText}" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding SnapshotText}"
                                        Opacity="0.55"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasSnapshotText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Restore"
                                    Tag="{Binding Id}"
                                    Click="Restore_Click"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    Grid.Column="2"
                                    Content="Delete now"
                                    Tag="{Binding Id}"
                                    Click="Delete_Click"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" />

        <ListView Grid.Row="3" ItemsSource="{Binding Records}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="2,6" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Opacity="0.7" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Path}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Command}" Opacity="0.6" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
