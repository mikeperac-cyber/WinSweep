<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,28,36,26">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="560"
            Spacing="18"
            Visibility="{Binding EmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="124" Height="124" CornerRadius="62" Background="#2D4C3522" HorizontalAlignment="Center">
                <Grid>
                    <Ellipse Width="82" Height="82" Fill="#816247" Stroke="#D4B08A" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE7C3;" FontSize="37" Foreground="#F1E3D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="Find where your space went." FontSize="29" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock
                Text="Map a folder to see its largest contents and files. Scans are read-only; partial results are clearly marked."
                FontSize="15"
                Opacity="0.72"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CurrentPath}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="Map this folder" Click="Scan_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
                <Button Content="Choose a folder" Click="Browse_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{Binding IsBusy}" Width="42" Height="42" HorizontalAlignment="Center" />
            <TextBlock Text="Mapping this folder" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
        </StackPanel>

        <Grid Visibility="{Binding ResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="Folder path" Text="{Binding CurrentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Map" VerticalAlignment="Stretch" Click="Scan_Click" />
                <Button Grid.Column="2" Content="Up" VerticalAlignment="Stretch" Click="Up_Click" />
                <Button Grid.Column="3" Content="Browse" VerticalAlignment="Stretch" Click="Browse_Click" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TotalText}" Opacity="0.6" />
                </StackPanel>
                <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{Binding IsBusy}" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0" ItemsSource="{Binding Entries}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entry_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="7,9" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Opacity="0.46" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Opacity="0.85" MinWidth="90" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Largest files" FontSize="17" FontWeight="SemiBold" />
                        <ListView ItemsSource="{Binding LargeFiles}" SelectionMode="None" MaxHeight="520">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,5" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.45" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeDisplay}" Opacity="0.8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
