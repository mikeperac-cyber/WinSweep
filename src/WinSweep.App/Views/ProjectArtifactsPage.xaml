<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinSweep.App.Views.ProjectArtifactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,26,36,26" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Project artifacts" FontSize="30" FontWeight="SemiBold" />
                <TextBlock
                    Text="Review rebuildable build output from the project folders you choose. Nothing leaves your PC."
                    Opacity="0.72"
                    TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.56" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Add folder"
                VerticalAlignment="Center"
                Click="AddRoot_Click" />

            <Button
                Grid.Column="2"
                Content="Scan projects"
                VerticalAlignment="Center"
                Click="Scan_Click"
                IsEnabled="{Binding CanScan}"
                Style="{StaticResource PrimaryActionButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folders" Opacity="0.62" VerticalAlignment="Center" />

            <ItemsControl Grid.Column="1" ItemsSource="{Binding Roots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{Binding}"
                                    MaxWidth="270"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.82" />
                                <Button
                                    Content="×"
                                    Tag="{Binding}"
                                    Click="RemoveRoot_Click"
                                    Padding="3,0"
                                    MinWidth="20"
                                    Height="20"
                                    FontSize="14"
                                    ToolTipService.ToolTip="Remove this scan folder" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Grid.Column="2"
                Text="{Binding RootSummary}"
                VerticalAlignment="Center"
                Opacity="0.55"
                FontSize="12" />
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Spacing="18"
                Visibility="{Binding EmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border
                    Width="124"
                    Height="124"
                    CornerRadius="62"
                    Background="#1F80B4A0"
                    HorizontalAlignment="Center">
                    <Grid>
                        <Ellipse
                            Width="82"
                            Height="82"
                            Fill="#4080B4A0"
                            Stroke="#8DB8A7"
                            StrokeThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="38"
                            Foreground="#E0EEE8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock
                    Text="Clear build leftovers."
                    FontSize="29"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Find old output such as node_modules, target, build and dist. Recent, linked, tracked, or uncertain folders stay untouched."
                    FontSize="15"
                    Opacity="0.72"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="{Binding StatusText}"
                    Opacity="0.62"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Add a project folder"
                    Click="AddRoot_Click"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />

                <Button
                    Content="Scan project folders"
                    Click="Scan_Click"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{Binding IsBusy}" Width="42" Height="42" HorizontalAlignment="Center" />
                <TextBlock Text="Finding project output" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProgressText}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
                <Button Content="Stop scan" Click="Cancel_Click" HorizontalAlignment="Center" />
            </StackPanel>

            <Grid
                Visibility="{Binding ResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                        <TextBlock Text="Only complete, inactive, untracked artifacts are preselected." Opacity="0.58" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Select safe" Click="SelectSafe_Click" VerticalAlignment="Center" Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Grid.Column="2" Content="Clear selection" Click="ClearSelection_Click" VerticalAlignment="Center" Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        Grid.Column="0"
                        ItemsSource="{Binding Artifacts}"
                        SelectionMode="None"
                        Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        IsEnabled="{Binding BlockedReason, Converter={StaticResource NullToBooleanConverter}}"
                                        VerticalAlignment="Center"
                                        MinWidth="40" />

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="in" Opacity="0.45" />
                                            <TextBlock Text="{Binding ProjectName}" Opacity="0.75" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StateText}" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.43" TextTrimming="CharacterEllipsis" FontSize="11" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActivityDisplay}" Opacity="0.56" FontSize="11" />
                                    </StackPanel>

                                    <FontIcon
                                        Grid.Column="3"
                                        Glyph="&#xE73E;"
                                        FontSize="14"
                                        Foreground="#83B8A0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="No build output found" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Try another project folder, or run the scan again after your next build." Opacity="0.65" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12" Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectedSummary}" VerticalAlignment="Center" Opacity="0.68" />
            <Button
                Grid.Column="1"
                Content="Move selected to Recycle Bin"
                Click="Remove_Click"
                IsEnabled="{Binding SelectedCount, Converter={StaticResource PositiveIntToBooleanConverter}}"
                Style="{StaticResource PrimaryActionButtonStyle}" />
        </Grid>
    </Grid>
</Page>
