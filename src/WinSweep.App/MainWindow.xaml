<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinSweep.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#20262C">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,10" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="10" Background="#2D4540">
                    <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line X1="13" Y1="2" X2="8" Y2="12" Stroke="#C8DDD2" StrokeThickness="2.2" />
                        <Polygon Points="5,11 14,13 12,18 3,16" Fill="#B8D6C9" />
                    </Canvas>
                </Border>
                <TextBlock Text="WinSweep" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Border
                x:Name="NavigationPill"
                Grid.Column="1"
                Background="#302F3338"
                CornerRadius="24"
                Padding="6"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="CleanNav" Content="Clean" Tag="Clean" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                    <Button x:Name="AppsNav" Content="Apps" Tag="Apps" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                    <Button x:Name="ProjectsNav" Content="Projects" Tag="Artifacts" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                    <Button x:Name="OptimizeNav" Content="Optimize" Tag="Optimize" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                    <Button x:Name="AnalyzeNav" Content="Analyze" Tag="Analyze" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                    <Button x:Name="StatusNav" Content="Status" Tag="Status" Style="{StaticResource NavigationButtonStyle}" Click="Navigation_Click" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button
                    Style="{StaticResource UtilityButtonStyle}"
                    ToolTipService.ToolTip="History"
                    AutomationProperties.Name="History"
                    Click="History_Click">
                    <FontIcon Glyph="&#xE81C;" FontSize="15" />
                </Button>
                <Button
                    Style="{StaticResource UtilityButtonStyle}"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    Click="Settings_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0" IsTabStop="False" />
    </Grid>
</Window>
